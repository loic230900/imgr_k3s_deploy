# Copier en ansible/.env (gitignoré) et remplir les valeurs sensibles.
# Sourcer avant ansible-playbook: `set -a && source ansible/.env && set +a`

export IMGR_CELERY_BROKER_URL=""
export IMGR_AWS_ACCESS_KEY_ID=""
export IMGR_AWS_SECRET_ACCESS_KEY=""
export REGISTRY_USER=""
export REGISTRY_PASSWORD=""

# Optionnels (valeurs par défaut dans group_vars/all.yml).
export IMGR_S3_BUCKET_NAME="cloud-virt-mai-waltzing-images"
export IMGR_AWS_REGION_NAME="eu-north-1"
export IMGR_REGISTRY_SERVER="registry.app.unistra.fr"
