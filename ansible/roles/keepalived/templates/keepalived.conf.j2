global_defs {
    script_user keepalived_script
    enable_script_security
}

# weight -60 > ecart vm1-vm2 (50) : la VIP migre si l'API K3s tombe.
vrrp_script chk_apiserver {
    script "/usr/local/bin/check_apiserver.sh"
    interval 5
    timeout 2
    rise 2
    fall 2
    weight -60
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == 'vm1' else 'BACKUP' }}
    interface {{ keepalived_vxlan_iface.stdout }}
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass imgr_ha
    }

    virtual_ipaddress {
        {{ floating_ip }}/24
    }

    track_script {
        chk_apiserver
    }
}
